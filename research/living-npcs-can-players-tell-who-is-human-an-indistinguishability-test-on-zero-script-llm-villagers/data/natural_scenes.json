[
 {
  "id": "A1",
  "build": "v0 (routines, reflex attack)",
  "t0": "2026-10-23T17:58:49",
  "t1": "2026-10-23T18:00:30",
  "humans": [
   "Rose"
  ],
  "lines": [
   {
    "ts": "2026-10-23T17:58:51.976Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Elsbeth",
    "text": "What do you want, Elsbeth?"
   },
   {
    "ts": "2026-10-23T17:58:51.998Z",
    "from": "Anselm",
    "kind": "npc",
    "to": "Agnes",
    "text": "Agnes, a word if you please."
   },
   {
    "ts": "2026-10-23T17:58:52.076Z",
    "from": "Elsbeth",
    "kind": "npc",
    "to": "Godric",
    "text": "Good day, Godric. What brings you to my barley field?"
   },
   {
    "ts": "2026-10-23T17:58:54.365Z",
    "from": "Elsbeth",
    "kind": "npc",
    "to": "Godric",
    "text": "I asked what you were doing here."
   },
   {
    "ts": "2026-10-23T17:58:54.427Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Elsbeth",
    "text": "I'm not in your field, woman. I'm by my forge. Mind your own business."
   },
   {
    "ts": "2026-10-23T17:58:54.474Z",
    "from": "Agnes",
    "kind": "npc",
    "to": "Anselm",
    "text": "Yes, Anselm? And you too, Aldric. What is it?"
   },
   {
    "ts": "2026-10-23T17:58:54.786Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Anselm",
    "text": "Anselm. You wanted a word with Agnes, not me."
   },
   {
    "ts": "2026-10-23T17:58:56.871Z",
    "from": "Elsbeth",
    "kind": "npc",
    "to": "Godric",
    "text": "You're right by my barley, Godric! Don't lie to me."
   },
   {
    "ts": "2026-10-23T17:58:56.915Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Elsbeth",
    "text": "Can't you see I'm working? Now leave me be."
   },
   {
    "ts": "2026-10-23T17:58:57.068Z",
    "from": "Agnes",
    "kind": "npc",
    "to": "Aldric",
    "text": "Aldric, Anselm asked for me. You need not stay."
   },
   {
    "ts": "2026-10-23T17:58:57.310Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Agnes",
    "text": "Just ensuring all is well, Agnes. Nothing more."
   },
   {
    "ts": "2026-10-23T17:58:57.355Z",
    "from": "Anselm",
    "kind": "npc",
    "to": "Aldric",
    "text": "My apologies, Aldric. I merely wished to speak with Agnes, but you were present. It is no matter."
   },
   {
    "ts": "2026-10-23T17:58:59.416Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Elsbeth",
    "text": "My forge is here, not your field! Stop bothering me."
   },
   {
    "ts": "2026-10-23T17:58:59.423Z",
    "from": "Elsbeth",
    "kind": "npc",
    "to": "Godric",
    "text": "Lying in my field, you are! I'll not stand for it."
   },
   {
    "ts": "2026-10-23T17:58:59.705Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Agnes",
    "text": "Very well. I shall leave you two to your talk."
   },
   {
    "ts": "2026-10-23T17:58:59.787Z",
    "from": "Anselm",
    "kind": "npc",
    "to": "Agnes",
    "text": "Agnes, I wished to ask if you have heard any news from the outside."
   },
   {
    "ts": "2026-10-23T17:58:59.796Z",
    "from": "Agnes",
    "kind": "npc",
    "to": "Aldric",
    "text": "Thank you, Aldric. I am well."
   },
   {
    "ts": "2026-10-23T17:59:01.913Z",
    "from": "Elsbeth",
    "kind": "npc",
    "to": "Godric",
    "text": "You are standing right on the edge of my barley, Godric! Don't try and fool me."
   },
   {
    "ts": "2026-10-23T17:59:02.902Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Anselm",
    "text": "Then I'll leave you be, Agnes. Anselm, a moment?"
   },
   {
    "ts": "2026-10-23T17:59:03.924Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Elsbeth",
    "text": "I've had enough of your nonsense, Elsbeth. Get gone or I'll throw you out myself."
   },
   {
    "ts": "2026-10-23T17:59:04.117Z",
    "from": "Agnes",
    "kind": "npc",
    "to": "Anselm",
    "text": "Nay, Anselm. The gates are barred, and no news comes in."
   },
   {
    "ts": "2026-10-23T17:59:07.642Z",
    "from": "Anselm",
    "kind": "npc",
    "to": "Agnes",
    "text": "Let us pray for our safety, then. Aldric, what is your need?"
   },
   {
    "ts": "2026-10-23T17:59:10.105Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Anselm",
    "text": "I'll not keep you long, Anselm. I asked but to see your business with Agnes was honest."
   },
   {
    "ts": "2026-10-23T17:59:12.969Z",
    "from": "Anselm",
    "kind": "npc",
    "to": "Aldric",
    "text": "Aldric, your concern is noted, but I assure you, my intentions are pure. Let us not let suspicions divide us."
   },
   {
    "ts": "2026-10-23T17:59:13.716Z",
    "from": "Osric",
    "kind": "npc",
    "to": null,
    "text": "Ah, Wat! Fine goods for a fine man. A dagger to protect thy wares, perhaps?"
   },
   {
    "ts": "2026-10-23T17:59:13.716Z",
    "from": "Agnes",
    "kind": "npc",
    "to": "Anselm",
    "text": "Anselm, I cannot help with news. My mind is heavy with grief."
   },
   {
    "ts": "2026-10-23T17:59:13.717Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Rose",
    "text": "Rose, isn't it about time for a warm meal? My stew's just ready."
   },
   {
    "ts": "2026-10-23T17:59:13.718Z",
    "from": "Wat",
    "kind": "npc",
    "to": null,
    "text": "Osric! I see you're still prowling around, always looking for a deal."
   },
   {
    "ts": "2026-10-23T17:59:15.388Z",
    "from": "Agnes",
    "kind": "npc",
    "to": "Anselm",
    "text": "I shall, Anselm. Aye, Aldric? What troubles you?"
   },
   {
    "ts": "2026-10-23T17:59:16.160Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Agnes",
    "text": "Anselm, I trust you. My duty is to all. Agnes, may I walk with you?"
   },
   {
    "ts": "2026-10-23T17:59:16.214Z",
    "from": "Osric",
    "kind": "npc",
    "to": null,
    "text": "Pah! Wasteful folk, the lot of them."
   },
   {
    "ts": "2026-10-23T17:59:16.309Z",
    "from": "Wat",
    "kind": "npc",
    "to": null,
    "text": "Osric! Don't walk away from me like that!"
   },
   {
    "ts": "2026-10-23T17:59:16.609Z",
    "from": "Anselm",
    "kind": "npc",
    "to": "Agnes",
    "text": "Then I shall pray for your comfort, Agnes. Let us seek solace together."
   },
   {
    "ts": "2026-10-23T17:59:18.246Z",
    "from": "Osric",
    "kind": "npc",
    "to": "Rowan",
    "text": "Rowan! A pleasure to see you. Have you need of fine silks or perhaps some spiced wine?"
   },
   {
    "ts": "2026-10-23T17:59:18.373Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Agnes",
    "text": "I seek no trouble, Agnes. I am but a guard, ever watchful. May I walk with you?"
   },
   {
    "ts": "2026-10-23T17:59:19.201Z",
    "from": "Wat",
    "kind": "npc",
    "to": null,
    "text": "Osric! How dare you turn your back on me!"
   },
   {
    "ts": "2026-10-23T17:59:19.297Z",
    "from": "Anselm",
    "kind": "npc",
    "to": "Aldric",
    "text": "Walk with her, Aldric. Your duty is a burden, but a worthy one."
   },
   {
    "ts": "2026-10-23T17:59:20.069Z",
    "from": "Rowan",
    "kind": "npc",
    "to": "Osric",
    "text": "I have no need for such finery, Osric. My axe is all I require."
   },
   {
    "ts": "2026-10-23T17:59:22.012Z",
    "from": "Wat",
    "kind": "npc",
    "to": null,
    "text": "Osric! You think you can just ignore me?"
   },
   {
    "ts": "2026-10-23T17:59:22.041Z",
    "from": "Osric",
    "kind": "npc",
    "to": "Rowan",
    "text": "A pity. Such a fine axe deserves a fine scabbard, perhaps?"
   },
   {
    "ts": "2026-10-23T17:59:22.718Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Anselm",
    "text": "You are kind, Anselm. I shall walk with Agnes."
   },
   {
    "ts": "2026-10-23T17:59:23.577Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Elsbeth",
    "text": "Elsbeth! I've warned you once. Leave me in peace or face the consequences."
   },
   {
    "ts": "2026-10-23T17:59:23.837Z",
    "from": "Wat",
    "kind": "npc",
    "to": "Osric",
    "text": "You won't get away this time, Osric!"
   },
   {
    "ts": "2026-10-23T17:59:23.885Z",
    "from": "Rowan",
    "kind": "npc",
    "to": "Osric",
    "text": "My axe needs no fancy cover. It serves me well."
   },
   {
    "ts": "2026-10-23T17:59:25.791Z",
    "from": "Osric",
    "kind": "npc",
    "to": "Wat",
    "text": "What is this? Accusations and insults! You will regret this!"
   },
   {
    "ts": "2026-10-23T17:59:26.343Z",
    "from": "Wat",
    "kind": "npc",
    "to": "Rowan",
    "text": "Rowan! Good to see you. That Osric is a slippery one, isn't he?"
   },
   {
    "ts": "2026-10-23T17:59:28.237Z",
    "from": "Rowan",
    "kind": "npc",
    "to": "Wat",
    "text": "Wat. Aye, he is."
   },
   {
    "ts": "2026-10-23T17:59:28.313Z",
    "from": "Osric",
    "kind": "npc",
    "to": "Wat",
    "text": "Wat, you old goat! Still peddling lies?"
   },
   {
    "ts": "2026-10-23T17:59:30.331Z",
    "from": "Wat",
    "kind": "npc",
    "to": "Osric",
    "text": "Lies? I speak the truth, Osric. You're the one who skulks about."
   },
   {
    "ts": "2026-10-23T17:59:30.664Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Rose",
    "text": "Oi! Rose! Are ye deaf? I asked ye a question!"
   },
   {
    "ts": "2026-10-23T17:59:32.185Z",
    "from": "Osric",
    "kind": "npc",
    "to": "Wat",
    "text": "Skulks? I am a merchant, you fool! And you spread lies about me!"
   },
   {
    "ts": "2026-10-23T17:59:33.209Z",
    "from": "Rose",
    "kind": "human",
    "to": "Marta",
    "text": "yeah"
   },
   {
    "ts": "2026-10-23T17:59:34.159Z",
    "from": "Wat",
    "kind": "npc",
    "to": "Osric",
    "text": "A merchant who hides in shadows? That's a good one, Osric!"
   },
   {
    "ts": "2026-10-23T17:59:35.115Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Rose",
    "text": "Well, it's about time! Come on in, don't stand there."
   },
   {
    "ts": "2026-10-23T17:59:36.050Z",
    "from": "Osric",
    "kind": "npc",
    "to": "Wat",
    "text": "Hides in shadows? I am merely waiting for the right customer, you meddling fool!"
   },
   {
    "ts": "2026-10-23T17:59:36.598Z",
    "from": "Wat",
    "kind": "npc",
    "to": "Osric",
    "text": "Still here, Osric? I thought you'd have run off by now."
   },
   {
    "ts": "2026-10-23T17:59:37.472Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Rose",
    "text": "You dare strike me?!"
   },
   {
    "ts": "2026-10-23T17:59:39.041Z",
    "from": "Wat",
    "kind": "npc",
    "to": "Osric",
    "text": "You hide and wait for customers? That's a good one, Osric!"
   },
   {
    "ts": "2026-10-23T17:59:55.603Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Rose",
    "text": "Rose! What happened to you?"
   },
   {
    "ts": "2026-10-23T17:59:56.036Z",
    "from": "Wat",
    "kind": "npc",
    "to": "Osric",
    "text": "Still here, Osric? I thought you'd have run off by now."
   },
   {
    "ts": "2026-10-23T17:59:56.264Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Rose",
    "text": "Rose! What happened here?"
   },
   {
    "ts": "2026-10-23T17:59:56.346Z",
    "from": "Elsbeth",
    "kind": "npc",
    "to": "Aldric",
    "text": "Aldric! Good to see you. Did you see what happened to Rose?"
   },
   {
    "ts": "2026-10-23T17:59:58.138Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Marta",
    "text": "Marta! What in the blazes do you think you are doing attacking her?"
   },
   {
    "ts": "2026-10-23T17:59:59.321Z",
    "from": "Rowan",
    "kind": "npc",
    "to": "Aldric",
    "text": "Aldric. You saw Rose?"
   },
   {
    "ts": "2026-10-23T17:59:59.528Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Elsbeth",
    "text": "I saw Marta attack her. What is this about?"
   },
   {
    "ts": "2026-10-23T18:00:00.167Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Godric",
    "text": "I did not attack her! She attacked me!"
   },
   {
    "ts": "2026-10-23T18:00:02.373Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Rowan",
    "text": "Aye, I saw her. Marta laid into her."
   },
   {
    "ts": "2026-10-23T18:00:02.914Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Aldric",
    "text": "Liar! She struck me first!"
   },
   {
    "ts": "2026-10-23T18:00:03.438Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Marta",
    "text": "Lies! I saw her strike you, Rose. Marta, you're lucky I've work to do, or I'd..."
   },
   {
    "ts": "2026-10-23T18:00:04.144Z",
    "from": "Elsbeth",
    "kind": "npc",
    "to": "Marta",
    "text": "Marta, what's got into you? Rose is hurt bad."
   },
   {
    "ts": "2026-10-23T18:00:06.322Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Marta",
    "text": "Silence, Marta. You're both lucky I've not drawn steel."
   },
   {
    "ts": "2026-10-23T18:00:06.391Z",
    "from": "Rowan",
    "kind": "npc",
    "to": "Aldric",
    "text": "Marta again? That woman's got a temper."
   },
   {
    "ts": "2026-10-23T18:00:08.495Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Godric",
    "text": "Godric, you saw it! Rose struck me first! She's a beast, but I won't kill her!"
   },
   {
    "ts": "2026-10-23T18:00:10.027Z",
    "from": "Rowan",
    "kind": "npc",
    "to": "Marta",
    "text": "Enough! Leave her be!"
   },
   {
    "ts": "2026-10-23T18:00:10.689Z",
    "from": "Aldric",
    "kind": "npc",
    "to": "Marta",
    "text": "These are serious accusations. Marta, what say you?"
   },
   {
    "ts": "2026-10-23T18:00:11.507Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Godric",
    "text": "You saw it, Godric! She struck me first! I'll not be called a liar!"
   },
   {
    "ts": "2026-10-23T18:00:12.385Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Marta",
    "text": "Begone, Marta. Your words are poison. I saw you kill her."
   },
   {
    "ts": "2026-10-23T18:00:13.705Z",
    "from": "Wat",
    "kind": "npc",
    "to": "Osric",
    "text": "Still here, Osric? I thought you'd have run off by now."
   },
   {
    "ts": "2026-10-23T18:00:15.524Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Marta",
    "text": "Away with you, Marta! I've no stomach for your lies. You've killed a villager."
   },
   {
    "ts": "2026-10-23T18:00:16.007Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Godric",
    "text": "Godric, you lie! You know Rose struck me first."
   },
   {
    "ts": "2026-10-23T18:00:19.148Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Godric",
    "text": "Godric, you know me! Why do you turn on me now?"
   },
   {
    "ts": "2026-10-23T18:00:19.313Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Marta",
    "text": "Enough, Marta! You killed Rose and you'll answer for it."
   }
  ]
 },
 {
  "id": "B1",
  "build": "v4 (routines, reflex attack)",
  "t0": "2026-10-24T01:44:00",
  "t1": "2026-10-24T01:45:00",
  "humans": [
   "Hugh"
  ],
  "lines": [
   {
    "ts": "2026-10-24T01:44:14.113Z",
    "from": "Elsbeth",
    "kind": "npc",
    "to": "Hugh",
    "text": "Hugh! You struck me again! I will not stand for this!"
   },
   {
    "ts": "2026-10-24T01:44:22.443Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Hugh",
    "text": "Hugh, you bastard! You dare strike me?"
   },
   {
    "ts": "2026-10-24T01:44:23.044Z",
    "from": "Elsbeth",
    "kind": "npc",
    "to": "Godric",
    "text": "Godric! Hugh! Stop this madness at once!"
   },
   {
    "ts": "2026-10-24T01:44:26.462Z",
    "from": "Wat",
    "kind": "npc",
    "to": null,
    "text": "Rowan! What news?"
   },
   {
    "ts": "2026-10-24T01:44:30.374Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Elsbeth",
    "text": "Madness? You call this madness, woman?"
   },
   {
    "ts": "2026-10-24T01:44:35.726Z",
    "from": "Hugh",
    "kind": "human",
    "to": "Godric",
    "text": "help"
   },
   {
    "ts": "2026-10-24T01:44:37.205Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Rowan",
    "text": "Well met, Rowan. Fancy seeing you here. Did you hear about Agnes? She's been having a terrible time."
   },
   {
    "ts": "2026-10-24T01:44:40.213Z",
    "from": "Anselm",
    "kind": "npc",
    "to": null,
    "text": "Peace be with you all. Godric, Elsbeth, I see you near the well. And Agnes, Wat, Hugh, Marta. Come closer, let us share the morning."
   },
   {
    "ts": "2026-10-24T01:44:40.514Z",
    "from": "Elsbeth",
    "kind": "npc",
    "to": "Godric",
    "text": "You call this madness, Godric? He attacked you, and you struck him back!"
   },
   {
    "ts": "2026-10-24T01:44:41.722Z",
    "from": "Rowan",
    "kind": "npc",
    "to": "Marta",
    "text": "Not now, I have work."
   },
   {
    "ts": "2026-10-24T01:44:43.129Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Hugh",
    "text": "Help who? You're the one bleeding out."
   },
   {
    "ts": "2026-10-24T01:44:46.241Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Rowan",
    "text": "We shall see."
   },
   {
    "ts": "2026-10-24T01:44:48.946Z",
    "from": "Agnes",
    "kind": "npc",
    "to": "Anselm",
    "text": "Good day, Brother Anselm. It is kind of you to gather us."
   },
   {
    "ts": "2026-10-24T01:44:49.145Z",
    "from": "Godric",
    "kind": "npc",
    "to": "Elsbeth",
