   {
    "ts": "2026-10-24T01:44:51.550Z",
    "from": "Rowan",
    "kind": "npc",
    "to": "Marta",
    "text": "Agnes? What's wrong?"
   },
   {
    "ts": "2026-10-24T01:44:53.415Z",
    "from": "Hugh",
    "kind": "human",
    "to": "Elsbeth",
    "text": "help pls"
   },
   {
    "ts": "2026-10-24T01:44:56.066Z",
    "from": "Marta",
    "kind": "npc",
    "to": "Rowan",
    "text": "Not now, I have work."
   },
   {
    "ts": "2026-10-24T01:44:57.468Z",
    "from": "Anselm",
